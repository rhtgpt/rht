DECLARE
  v_size1 NUMBER;
  v_size2 NUMBER;
BEGIN
  FOR i IN 1..30 LOOP
    -- generate random size between 50MB and 100MB for both LOBs
    v_size1 := TRUNC(DBMS_RANDOM.VALUE(52428800, 104857600));
    v_size2 := TRUNC(DBMS_RANDOM.VALUE(52428800, 104857600));

    INSERT INTO GD.CIM_OFM_SMG3_LOGGING
      (TRACE_ID, ALIAS, AUDIT_CREATE_DATE, SMG3_LOGGING_DATA, FILTRATION_JSON_DATA)
    VALUES
      (
        SYS_GUID(),
        CASE MOD(i, 2) WHEN 0 THEN 'ASIA' ELSE 'EU' END,  -- alternate alias
        TRUNC(SYSDATE) - i,                               -- past 30 days
        RPAD('S', v_size1, 'S'),                          -- random 50–100 MB
        RPAD('F', v_size2, 'F')                           -- random 50–100 MB
      );
  END LOOP;

  COMMIT;
END;
/
