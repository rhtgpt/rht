DECLARE
  v_size1 NUMBER;
  v_size2 NUMBER;
BEGIN
  FOR i IN 1..30 LOOP
    -- simulate random by using MOD on unique session values
    v_size1 := 52428800 + MOD(DBMS_UTILITY.GET_TIME * i, 52428800);
    v_size2 := 52428800 + MOD(DBMS_UTILITY.GET_TIME * (i+5), 52428800);

    INSERT INTO GD.CIM_OFM_SMG3_LOGGING
      (TRACE_ID, ALIAS, AUDIT_CREATE_DATE, SMG3_LOGGING_DATA, FILTRATION_JSON_DATA)
    VALUES
      (
        SYS_GUID(),
        CASE MOD(i, 2) WHEN 0 THEN 'ASIA' ELSE 'EU' END,
        TRUNC(SYSDATE) - i,
        RPAD('S', v_size1, 'S'),
        RPAD('F', v_size2, 'F')
      );
  END LOOP;

  COMMIT;
END;
/
