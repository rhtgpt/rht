SET PAGESIZE 0 FEEDBACK OFF VERIFY OFF HEADING OFF
SET SERVEROUTPUT ON SIZE UNLIMITED
SET TERMOUT ON

-- capture START timestamp (as text we can reuse later)
COLUMN TS_START_TZ NEW_VALUE TS_START_TZ
SELECT TO_CHAR(SYSTIMESTAMP,'YYYY-MM-DD HH24:MI:SS.FF3 TZH:TZM') TS_START_TZ FROM dual;





===========================================



COLUMN TS_END_TZ NEW_VALUE TS_END_TZ
SELECT TO_CHAR(SYSTIMESTAMP,'YYYY-MM-DD HH24:MI:SS.FF3 TZH:TZM') TS_END_TZ FROM dual;


========================================



-- compute ELAPSED time (as INTERVAL DAY TO SECOND) and print it
COLUMN ELAPSED NEW_VALUE ELAPSED
SELECT ( TO_TIMESTAMP_TZ('&TS_END_TZ','YYYY-MM-DD HH24:MI:SS.FF3 TZH:TZM')
       - TO_TIMESTAMP_TZ('&TS_START_TZ','YYYY-MM-DD HH24:MI:SS.FF3 TZH:TZM') ) AS ELAPSED
FROM dual;

PROMPT Time taken: &ELAPSED
PROMPT ===============================================================
