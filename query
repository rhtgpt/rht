DECLARE
  v_blob1  BLOB;
  v_blob2  BLOB;
BEGIN
  FOR i IN 1 .. 100 LOOP   -- insert 100 sample rows
    -- create small sample blob data
    DBMS_LOB.CREATETEMPORARY(v_blob1, TRUE);
    DBMS_LOB.CREATETEMPORARY(v_blob2, TRUE);

    DBMS_LOB.WRITEAPPEND(v_blob1, LENGTH('SMG3_DATA_SAMPLE'), UTL_RAW.CAST_TO_RAW('SMG3_DATA_SAMPLE'));
    DBMS_LOB.WRITEAPPEND(v_blob2, LENGTH('FILTER_JSON_SAMPLE'), UTL_RAW.CAST_TO_RAW('FILTER_JSON_SAMPLE'));

    INSERT INTO GD.CIM_OFM_SMG3_LOGGING
      (TRACE_ID, ALIAS, AUDIT_CREATE_DATE, SMG3_LOGGING_DATA, FILTRATION_JSON_DATA)
    VALUES
      (SYS_GUID(),
       CASE MOD(i,2) WHEN 0 THEN 'ASIA' ELSE 'EU' END,
       SYSTIMESTAMP,        -- keeps full date+time
       v_blob1,
       v_blob2);

    DBMS_LOB.FREETEMPORARY(v_blob1);
    DBMS_LOB.FREETEMPORARY(v_blob2);
  END LOOP;

  COMMIT;
END;
/
