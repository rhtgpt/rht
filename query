PROMPT *** CUTOVER: pause application writes now ***
DECLARE
  v_max_new_ts  TIMESTAMP(6);
BEGIN
  SELECT NVL(MAX(AUDIT_CREATE_DATE), TIMESTAMP'1900-01-01 00:00:00')
    INTO v_max_new_ts
  FROM GD.CIM_NC_DART_LOGGING_NEW;

  INSERT /*+ APPEND PARALLEL(GD.CIM_NC_DART_LOGGING_NEW,32) */
  INTO GD.CIM_NC_DART_LOGGING_NEW
    (TRACE_ID, AUDIT_CREATE_DATE, NC_REQUEST_DATA, NC_RESPONSE_DATA)
  SELECT /*+ PARALLEL(s,32) */
         s.TRACE_ID, s.AUDIT_CREATE_DATE, s.NC_REQUEST_DATA, s.NC_RESPONSE_DATA
  FROM   GD.CIM_NC_DART_LOGGING s
  WHERE  s.AUDIT_CREATE_DATE > v_max_new_ts
    AND  NOT EXISTS (
           SELECT 1
           FROM GD.CIM_NC_DART_LOGGING_NEW n
           WHERE n.TRACE_ID = s.TRACE_ID
             AND n.AUDIT_CREATE_DATE = s.AUDIT_CREATE_DATE
         );
  COMMIT;
END;
